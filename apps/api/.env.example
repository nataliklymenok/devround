NODE_ENV=development
# Local Homebrew Postgres: postgresql://<your-user>@localhost:5432/devround
# Docker compose:          postgresql://devround:devround@localhost:5432/devround
DATABASE_URL=postgresql://devround:devround@localhost:5432/devround
# Used by the test suite (npm test)
TEST_DATABASE_URL=postgresql://devround:devround@localhost:5433/devround_test
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# google | fake (fake = dev sign-in by email, never allowed in production)
AUTH_PROVIDER=google
WEB_ORIGIN=http://localhost:5173
PORT=3000
CONTENT_DIR=../../content
WEB_DIST_DIR=../web/dist
