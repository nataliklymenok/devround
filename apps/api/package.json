{
  "name": "@devround/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "content:validate": "tsx --env-file-if-exists=.env scripts/content/validate.ts",
    "content:check-ids": "tsx --env-file-if-exists=.env scripts/content/check-ids.ts",
    "content:sync": "tsx --env-file-if-exists=.env scripts/content/sync.ts",
    "e2e:reset": "prisma migrate deploy && tsx scripts/e2e-reset.ts"
  },
  "dependencies": {
    "@devround/shared": "^0.0.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "gray-matter": "^4.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^7.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
